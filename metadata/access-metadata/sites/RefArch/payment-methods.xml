<?xml version="1.0" encoding="UTF-8"?>
<payment-settings xmlns="http://www.demandware.com/xml/impex/paymentsettings/2009-09-15">

    <payment-method method-id="Worldpay">
        <name xml:lang="x-default">Worldpay Hosted Payment Page</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>Worldpay</processor-id>
        <custom-attributes>
            <custom-attribute attribute-id="type">REDIRECT</custom-attribute>
        </custom-attributes>
    </payment-method>
    <payment-method method-id="WORLDPAY_CHECKOUTSDK">
        <name xml:lang="x-default">Worldpay Checkout SDK</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>Worldpay</processor-id>
        <custom-attributes>
            <custom-attribute attribute-id="type">DIRECT</custom-attribute>
        </custom-attributes>
    </payment-method>

</payment-settings>
