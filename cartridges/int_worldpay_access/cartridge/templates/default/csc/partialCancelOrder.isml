<iscomment>
    TEMPLATENAME: partialCancelOrder.isml
</iscomment>
<html>
<head>
    <style type="text/css">
        @charset "UTF-8";
        [ng\:cloak],[ng-cloak],[data-ng-cloak],[x-ng-cloak],.ng-cloak,.x-ng-cloak,
        .ng-hide:not(.ng-hide-animate){display:none !important;}
        ng\:form{display:block;}
        .ng-animate-shim{visibility:hidden;}
        .ng-anchor{position:absolute;}
    </style>
    <link rel="stylesheet" href="${URLUtils.staticURL('/application/csc/lib/buist/resources')}/dw.ui.core.css"/>
    <link rel="stylesheet" href="${URLUtils.staticURL('/application/csc/lib/buist/resources')}/dw.ui.core.directives.css"/>
</head>
<body>
<div class="card-body card-info-group">
    <div class="order-details">
        <h3>Order Information (Partial Cancel)</h3>
        <table class="table table-bordered">
            <tr>
                <td><strong>Order ID:</strong></td>
                <td>${pdict.orderID}</td>
            </tr>
            <tr>
                <td><strong>Payment Status:</strong></td>
                <td>${pdict.paymentStatus || 'Unknown'}</td>
            </tr>
            <tr>
                <td><strong>Message:</strong></td>
                <td>${pdict.message}</td>
            </tr>
            <tr>
                <td><strong>Currency:</strong></td>
                <td>${pdict.currency}</td>
            </tr>
            <isif condition="${pdict.totalAmount}">
                <tr>
                    <td><strong>Total authorized amount:</strong></td>
                    <td>${pdict.totalAmount}</td>
                </tr>
            </isif>
            <tr>
                <td><strong>Partial Cancel Link:</strong></td>
                <td>${pdict.partialCancelHrefUrlPath}</td>
            </tr>
        </table>
    </div>

    <isif condition="${pdict.success == true}">
        <div class="capture-form">
            <form action="${URLUtils.url('Csc-PartialCancelOrder')}" method="post">
                <input type="hidden" name="order_no" value="${pdict.orderID}" />
                <input type="hidden" name="partialCancelHrefUrlPath" value="${pdict.partialCancelHrefUrlPath}" />
                <input type="hidden" name="currency" value="${pdict.currency}" />

                <h4>Select quantities to partially cancel</h4>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Image</th>
                            <th>Ordered qty</th>
                            <th>Line total (${pdict.currency})</th>
                            <th>Quantity to cancel</th>
                        </tr>
                    </thead>
                    <tbody>
                        <isloop items="${pdict.lineItems}" var="item">
                            <tr>
                                <td>${item.name} (${item.productID})</td>
                                <td>
                                    <isif condition="${item.imageURL}">
                                        <img src="${item.imageURL}" alt="${item.name}" style="max-width:50px; max-height:50px;" />
                                    <iselse/>
                                        N/A
                                    </isif>
                                </td>
                                <td>${item.quantity}</td>
                                <td>${item.lineTotalMajor}</td>
                                <td>
                                    <input type="number"
                                        name="${'cancelQty_' + item.uuid}"
                                        class="dw-textfield"
                                        step="1"
                                        min="0"
                                        max="${item.quantity}"
                                        value="0" />
                                </td>
                            </tr>
                        </isloop>
                    </tbody>
                </table>

                <div class="form-group">
                    <button type="submit" class="dw-button dw-button-primary">Partial Cancel</button>
                </div>
            </form>
        </div>
    <iselse/>
        <p>Payment cannot be partially canceled in its current state.</p>
    </isif>
</div>
</body>
</html>