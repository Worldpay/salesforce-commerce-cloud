<iscontent type="text/html" charset="UTF-8" compact="true"/>
<html>
<head></head>
<body>
    <form id="collectionForm" name="devicedata" method="POST" action="${pdict.ddcUrl}">
        <input type="hidden" name="Bin" value="${pdict.ddcBin}" />
        <input type="hidden" name="JWT" value="${pdict.ddcJwt}" />
    </form>
    <script>
        window.onload = function () {
            document.getElementById('collectionForm').submit();
        };
    </script>
</body>
</html>
