<li class="nav-item nav-tiles" data-method-id="${paymentOption.ID}" id="${paymentOption.ID}" role="tab">
    <isif condition="${paymentOption.ID === 'IDEAL-SSL'}">
        <a class="nav-link <isif condition="${selectedPaymentInstrument.paymentMethod === paymentOption.ID}">active</isif>" data-toggle="tab" href="#ideal-content">
            <isif condition="${paymentOption.apmImagePath != null}"> 
                <img class="credit-card-option"
                    src="${paymentOption.apmImagePath}"
                    height="32"
                    alt="${paymentOption.name}"
                    title="${paymentOption.name}"
                />
            <iselse/>
                <img class="credit-card-option"
                    src="${URLUtils.staticURL('/images/' + paymentOption.ID + '.png')}"
                    height="32"
                    alt="${paymentOption.name}"
                    title="${paymentOption.name}"
                />
            </isif>
        </a>

    <iselseif condition="${paymentOption.ID === 'SEPA_DIRECT_DEBIT-SSL'}"/>
        <a class="nav-link <isif condition="${selectedPaymentInstrument.paymentMethod === paymentOption.ID}">active</isif>" data-toggle="tab" href="#elv-content">
            <isif condition="${paymentOption.apmImagePath != null}"> 
                <img class="credit-card-option"
                    src="${paymentOption.apmImagePath}"
                    height="32"
                    alt="${paymentOption.name}"
                    title="${paymentOption.name}"
                />
            <iselse/>
                <img class="credit-card-option"
                    src="${URLUtils.staticURL('/images/' + paymentOption.ID + '.png')}"
                    height="32"
                    alt="${paymentOption.name}"
                    title="${paymentOption.name}"
                />
            </isif>
        </a>

    <iselseif condition="${paymentOption.ID === 'ACH_DIRECT_DEBIT-SSL'}"/>
        <a class="nav-link <isif condition="${selectedPaymentInstrument.paymentMethod === paymentOption.ID}">active</isif>" data-toggle="tab" href="#ach-content">
            <isif condition="${paymentOption.apmImagePath != null}"> 
                <img class="credit-card-option"
                    src="${paymentOption.apmImagePath}"
                    height="32"
                    alt="${paymentOption.name}"
                    title="${paymentOption.name}"
                />
            <iselse/>
                <img class="credit-card-option"
                    src="${URLUtils.staticURL('/images/' + paymentOption.ID + '.png')}"
                    height="32"
                    alt="${paymentOption.name}"
                    title="${paymentOption.name}"
                />
            </isif>
        </a>
    <iselseif condition="${paymentOption.ID === 'Worldpay'}"/>
        <a class="nav-link <isif condition="${selectedPaymentInstrument.paymentMethod === paymentOption.ID}">active</isif>" data-toggle="tab" href="#credit-card-content-redirect">
            <isif condition="${paymentOption.apmImagePath != null}"> 
                <img class="credit-card-option"
                    src="${paymentOption.apmImagePath}"
                    height="32"
                    alt="${paymentOption.name}"
                    title="${paymentOption.name}"
                />
            <iselse/>
                 ${Resource.msg('WorldpayConstants.CREDIT_CARD_REDIRECT','worldpay',null)}
            </isif>
        </a>
     <iselseif condition="${paymentOption.ID === 'DW_APPLE_PAY'}"/>
        <a class="nav-link <isif condition="${selectedPaymentInstrument.paymentMethod === paymentOption.ID}">active</isif>" data-toggle="tab" href="#applepay-content">
            <isif condition="${paymentOption.apmImagePath != null}"> 
                <img class="credit-card-option"
                    src="${paymentOption.apmImagePath}"
                    height="32"
                    alt="${paymentOption.name}"
                    title="${paymentOption.name}"
                />
               <iselse>
                <img class="credit-card-option"
                    src="${URLUtils.staticURL('/images/' + paymentOption.ID + '.png')}"
                    height="32"
                    alt="${paymentOption.name}"
                    title="${paymentOption.name}"
                />
            </isif>
        </a>
    <iselseif condition="${paymentOption.ID === 'PAYWITHGOOGLE-SSL'}"/>
        <a class="nav-link <isif condition="${selectedPaymentInstrument.paymentMethod === paymentOption.ID}">active</isif>" data-toggle="tab" href="#googlepaycontent">
            <isif condition="${paymentOption.apmImagePath != null}"> 
                <img class="credit-card-option"
                    src="${paymentOption.apmImagePath}"
                    height="32"
                    alt="${paymentOption.name}"
                    title="${paymentOption.name}"
                />
            <iselse/>
                <img class="credit-card-option"
                    src="${URLUtils.staticURL('/images/' + paymentOption.ID + '.png')}"
                    height="32"
                    alt="${paymentOption.name}"
                    title="${paymentOption.name}"
                />
            </isif>
            
        </a>
    <iselseif condition="${paymentOption.ID === 'KLARNA'}"/>
        <a class="nav-link <isif condition="${selectedPaymentInstrument.paymentMethod === paymentOption.ID}">active</isif>" data-toggle="tab" href="#redirect-content">
            <isif condition="${paymentOption.apmImagePath != null}"> 
                <img class="credit-card-option"
                    src="${paymentOption.apmImagePath}"
                    height="32"
                    alt="${paymentOption.name}"
                    title="${paymentOption.name}"
                />
            <iselse/>
                ${paymentOption.name}
            </isif>
        </a>
    <iselseif condition="${paymentOption.ID === 'PAYPAL-SSL'}"/>
        <a class="nav-link <isif condition="${selectedPaymentInstrument.paymentMethod === paymentOption.ID}">active</isif>" data-toggle="tab" href="#redirect-content">
            <isif condition="${paymentOption.apmImagePath != null}"> 
                <img class="credit-card-option"
                    src="${paymentOption.ID}"
                    height="32"
                    alt="${paymentOption.name}"
                    title="${paymentOption.name}"
                />
            <iselse/>
                ${paymentOption.name}
            </isif>
        </a>
    <iselse/>
        <a alt="${paymentOption.name}" class="nav-link <isif condition="${selectedPaymentInstrument.paymentMethod === paymentOption.ID}">active</isif>" data-toggle="tab" href="#redirect-content">
            <isif condition="${paymentOption.apmImagePath != null}"> 
                <img class="credit-card-option"
                    src="${paymentOption.apmImagePath}"
                    height="32"
                    alt="${paymentOption.name}"
                    title="${paymentOption.name}"
                />
            <iselse/>
                <img class="credit-card-option"
                    src="${URLUtils.staticURL('/images/' + paymentOption.ID + '.png')}"
                    height="32"
                    alt="${paymentOption.name}"
                    title="${paymentOption.name}"
                />
            </isif>
        </a>
    </isif>
</li>

